{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAppConfigBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::davine-wk1-dev-app-config"
    },
    {
      "Sid": "ReadAppConfigObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::davine-wk1-dev-app-config/*"
    }
  ]
}
